# --- Database (Postgres) ------------------------------------------------
POSTGRES_URL="postgresql://admin:admin@localhost:5432/locaul-science"

# --- Auth ----------------------------------------------------------------
# Signs JWTs (HS256). Generate a real one for anything beyond local dev:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-me-to-a-random-64-char-hex-string"

# --- External article/PDF repository -----------------------------------
# ARTICLES_LIST_URL must return a JSON array of relative PDF paths, e.g.
#   ["g.pdf", "libgen.scimag.../10.1002/....pdf"]
# ARTICLES_BASE_URL is prefixed to each path to fetch the actual PDF:
#   `${ARTICLES_BASE_URL}/${path}`
ARTICLES_LIST_URL="http://10.80.31.12:3000/articles"
ARTICLES_BASE_URL="http://10.80.31.12:3000"

# --- Primary LLM (OpenAI-compatible) ------------------------------------
# Used for /make-science's title+abstract extraction (always) and as the
# default "gpt-oss" option in both chat pages' model picker. Works with
# OpenAI itself, Groq, a local vLLM/Ollama server hosting gpt-oss-120b, etc.
OPENAI_API_KEY="sk-..."
OPENAI_BASE_URL="https://api.openai.com/v1"
MODEL_NAME="gpt-oss-120b"

# --- Second LLM option: Google Generative AI (Gemini) -------------------
# Powers the "gemini-flash-lite" option in both chat pages' model picker.
GOOGLE_GENERATIVE_AI_API_KEY="AIza..."
GEMINI_MODEL_NAME="gemini-3.1-flash-lite"

# --- make-science-gemma4 (page-image indexing via backend/ FastAPI service) --
# BACKEND_URL: where the FastAPI service in backend/ is listening (it's a
# separate process — see backend/README.md — not started by `npm run dev`).
# INTERNAL_API_SECRET: shared secret so the backend can call back into
# Next.js (POST /api/articles-gemma4/ingest-page) without a user JWT. Must
# match the same value in backend/.env. Generate one the same way as
# JWT_SECRET above.
BACKEND_URL="http://localhost:8000"
INTERNAL_API_SECRET="change-me-to-a-random-shared-secret"
# Optional: seeds the /settings API-key pool with one entry (source "env")
# the first time that pool is empty. After that, keys are managed at
# /settings and stored in Postgres — this var isn't re-read once seeded,
# and the backend service is never given its own key to hold onto.
CEREBRAS_API_KEY="csk-..."

# --- Optional: runPythonCode tool ---------------------------------------
# Off by default. This runs model-generated Python as a REAL subprocess on
# the server with only a timeout + output cap — NOT a security sandbox.
# Only set to "true" in a trusted, single-user local environment. Requires
# `python3` to be on PATH wherever this app runs.
ENABLE_PYTHON_TOOL="false"
