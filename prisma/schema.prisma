generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// One row per indexed PDF from the external article repository.
// `url` is the relative path exactly as returned by ARTICLES_LIST_URL
// (e.g. "libgen.scimag00100000-00100999/10.1002/....pdf") — it's the
// natural unique key since that's also how we re-check "already indexed?"
// on every /make-science and /make-science-gemma4 visit.
model Article {
  id          String   @id @default(cuid())
  url         String   @unique
  pdfUrl      String
  title       String
  abstract    String
  pageCount   Int?
  status      String   @default("indexed") // old (/make-science) pipeline: "indexed" | "failed"
  errorReason String?
  // gemma4 pipeline tracked separately since a url can be indexed by one
  // pipeline and not the other — see make-science-gemma4.
  gemmaStatus String? // null (not run) | "partial" | "indexed" | "failed"
  gemmaError  String?
  // Rolled-up view of this article's per-page embedding state, derived from
  // its ArticlePage rows after every embedding batch. Purely a read
  // optimization for /library and /make-embedding's stat cards — the
  // authoritative, resumable state lives on ArticlePage.
  embeddingStatus String? // null (not run) | "partial" | "embedded" | "failed"
  embeddedAt      DateTime?
  createdAt   DateTime      @default(now())
  pages       ArticlePage[]
}

// One row per PDF page, produced by the make-science-gemma4 pipeline
// (pdf2image render -> Cerebras gemma-4-31b vision call -> markdown).
// Unlike the old pipeline's `firstPage` (removed), every page is stored,
// so chat tools can read a whole article's real content instead of
// re-fetching and re-parsing the PDF live on every call.
model ArticlePage {
  id         String   @id @default(cuid())
  articleId  String
  article    Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  pageNumber Int
  content    String // markdown transcription from Gemma
  createdAt  DateTime @default(now())

  // --- Qdrant embedding state (make-embedding pipeline) -----------------
  // A page is too big to embed as one vector, so it's split into
  // deterministic ~N-token chunks (see backend/app/services/chunking.py).
  // Chunking is a pure function of (content, chunkTokens, chunkOverlap),
  // so chunk *index* is stable across runs — which is what makes
  // "resume this page from chunk 7" correct rather than approximate.
  //
  // embeddingStatus: "pending" (never embedded) | "partial" (some chunks
  // in Qdrant, stopped/failed midway) | "embedded" | "failed".
  embeddingStatus String  @default("pending")
  // Total chunks this page splits into. 0 until the first run computes it.
  chunkCount      Int     @default(0)
  // How many of those chunks are confirmed upserted into Qdrant. The
  // resume cursor: the next run starts this page at chunk #embeddedChunks.
  embeddedChunks  Int     @default(0)
  // sha256 of the content that was chunked, plus the chunk params baked in.
  // If a page is re-transcribed (or the chunk size changes), this stops
  // matching and the page is re-embedded from chunk 0 instead of silently
  // leaving stale vectors behind.
  contentHash     String?
  embeddingModel  String?
  embeddingError  String?
  embeddedAt      DateTime?

  @@unique([articleId, pageNumber])
  @@index([embeddingStatus])
}

// A pool of Cerebras API keys usable by the make-science-gemma4 pipeline —
// managed from /settings, not from backend/.env. If this table is empty
// and CEREBRAS_API_KEY is set in the Next.js app's own .env, it's
// auto-seeded as one entry (source "env") the first time the pool is read.
// The Python backend never stores keys itself: Next.js sends whichever
// key(s) apply to a given /index-article call in the request body.
model CerebrasApiKey {
  id        String   @id @default(cuid())
  label     String?
  key       String
  source    String   @default("manual") // "manual" | "env"
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
}

// Single-row app-wide settings (fixed id "singleton", upserted lazily).
model AppSettings {
  id String @id @default("singleton")
  // "pages_per_pdf" (default): one article at a time, all enabled keys
  // split across that article's pages concurrently.
  // "pdfs_per_key": up to N articles processed concurrently (N = enabled
  // key count), each assigned exactly one key, pages sequential per article.
  gemma4ConcurrencyMode String @default("pages_per_pdf")

  // --- make-embedding (Qdrant) -----------------------------------------
  // Kept here rather than in .env because changing chunk size changes how
  // every page is split, which has to invalidate ArticlePage.contentHash —
  // a database-visible decision, not a deployment detail. The Python
  // service is told these values per request and holds no opinion itself.
  embeddingCollection  String @default("fastembed_articles")
  embeddingModel       String @default("BAAI/bge-small-en")
  embeddingChunkTokens Int    @default(500)
  // Chunks overlap slightly so a sentence split across a boundary is still
  // retrievable from at least one whole-sentence chunk.
  embeddingChunkOverlap Int   @default(60)
  // How many pages are handed to the Python service in one call. Bigger =
  // fewer round trips, but coarser stop granularity.
  embeddingPageBatch    Int   @default(8)

  // --- Springer stage 3 ------------------------------------------------
  // Base URL of the full-text PDF provider; the article's DOI is appended
  // as a path, e.g. "https://myprovider.com" -> "https://myprovider.com/10.1007/s10853-025-11875-6".
  springerPdfProviderUrl String?
  // How long stage 3 waits on a provider's browser-check / CAPTCHA page
  // (for it to clear itself, or for you to solve it in the visible window)
  // before marking that article "failed".
  springerPdfChallengeTimeoutSec Int @default(120)
}

// A configured AI provider instance (not a fixed enum) — two rows can both
// be type "openai-compatible" (e.g. a local Ollama box and a remote Groq
// key are unrelated instances of the same wire protocol), so baseUrl/apiKey
// live per-row rather than per-type. Managed from /settings, same
// global/app-wide shape as CerebrasApiKey above (no per-user scoping).
model AiProvider {
  id        String   @id @default(cuid())
  type      String   // "openai-compatible" | "google"
  label     String   // e.g. "Ollama (local)", "Groq"
  baseUrl   String?  // required for "openai-compatible"; unused for "google"
  apiKey    String?  // nullable — many local openai-compatible servers need no key
  enabled   Boolean  @default(true)
  source    String   @default("manual") // "manual" | "env" — same convention as CerebrasApiKey.source
  createdAt DateTime @default(now())
  models    AiProviderModel[]
}

// One selectable chat model under a provider. `wireId` is what the client
// sends as `model` in /api/chat's request body and what's persisted on
// Chat.model — once created it must stay stable, since old Chat rows
// reference it by value indefinitely (see ai-provider.ts's getModel()
// fallback for what happens when a wireId no longer resolves).
model AiProviderModel {
  id         String     @id @default(cuid())
  providerId String
  provider   AiProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  wireId     String     @unique // e.g. "gpt-oss", "gemini-flash-lite", or a cuid for user-added models
  modelName  String     // actual model name sent to the provider API, e.g. "llama3.1:8b"
  label      String?    // optional display override; falls back to modelName
  enabled    Boolean    @default(true)
  createdAt  DateTime   @default(now())

  @@index([providerId])
}

// A Springer journal a user has registered by its numeric journal id (the
// path segment in https://link.springer.com/journal/<journalId>, e.g.
// "10853" for Journal of Materials Science). Crawling is page-cursor based
// since a journal's article-list page is paginated server-side (50/page)
// and can run into the tens of thousands of articles — `lastListPage` is
// how far the list crawl has gotten, so "crawl next page" always resumes
// rather than re-walking from page 1.
model SpringerJournal {
  id            String   @id @default(cuid())
  journalId     String   @unique // e.g. "10853"
  name          String
  url           String
  lastListPage  Int      @default(0)
  totalArticles Int? // from the list page's "Showing 1-50 of N articles" line
  createdAt     DateTime @default(now())
  articles      SpringerArticle[]
}

// One row per article discovered on a journal's article-list page, keyed by
// DOI (globally unique, unlike Article.url which is a mirror-specific
// path). Rows are created as stubs (title/href/doi only) by the list crawl,
// then filled in by the detail crawl — the two-stage split mirrors
// /make-science vs /make-science-gemma4's "list first, content second"
// shape, since fetching every article's own page is far more expensive
// than paging through the list.
model SpringerArticle {
  id            String          @id @default(cuid())
  journalId     String
  journal       SpringerJournal @relation(fields: [journalId], references: [id], onDelete: Cascade)
  doi           String          @unique
  href          String
  title         String
  section       String? // e.g. "Composites & nanocomposites"
  publishedDate String? // as shown on the site, e.g. "10 September 2026" — not parsed, just displayed
  openAccess    Boolean         @default(false)
  abstract      String?
  // Full-text markdown-ish content, only populated for open-access articles
  // (paywalled ones only ever expose the abstract) — pulled from the
  // article page's `.main-content` sections (Introduction, Results, etc.).
  content       String?
  status        String          @default("pending") // "pending" (stub from list crawl) | "indexed" (detail crawl done) | "failed"
  errorReason   String?

  // --- Stage 3: full-text PDF from the configured content provider --------
  // (AppSettings.springerPdfProviderUrl + "/" + doi). Independent of
  // `status`, since a paywalled article with only an abstract can still
  // have its PDF available from the provider.
  // null (never tried) | "downloaded" | "not_found" (provider answered but
  // had no PDF for this DOI) | "failed" (network/timeout/etc — retryable)
  pdfStatus     String?
  pdfPath       String? // relative to SPRINGER_PDF_DIR, e.g. "10.1007/s10853-025-11875-6.pdf"
  pdfSize       Int?
  pdfSourceUrl  String? // final URL the PDF was served from, after any provider redirects
  pdfError      String?
  pdfCheckedAt  DateTime?

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([journalId])
  @@index([status])
  @@index([pdfStatus])
}

// One row per PDF fetched by DOI — from /doi or /springer/one-link — no
// matter the publisher. Keyed by DOI (unlike Article, keyed by a mirror
// url); the PDF itself lives on local disk under springer-pdf.ts's
// PDF_ROOT. Pages are transcribed by the same render-to-image → gemma4
// vision pipeline as make-science-gemma4, but through a user-picked
// openai-compatible AiProvider instead of the Cerebras key pool.
model ArticleByDOI {
  id        String  @id @default(cuid())
  doi       String  @unique
  source    String  @default("doi") // "doi" | "springer" (also a SpringerArticle row with this doi)
  // Extracted from page 1's transcription; null until that has run.
  title     String?
  abstract  String?
  pdfPath   String // relative to SPRINGER_PDF_DIR, e.g. "10.1007/s10853-025-11876-5.pdf"
  pdfSize   Int?
  pageCount Int?
  // null (not transcribed) | "partial" (some pages failed — re-run resumes) | "indexed" | "failed"
  status    String?
  error     String?
  // Which provider/model produced the pages, shown alongside them.
  transcribeProvider String?
  transcribeModel    String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  pages     ArticleByDOIPage[]

  @@index([status])
}

model ArticleByDOIPage {
  id         String       @id @default(cuid())
  articleId  String
  article    ArticleByDOI @relation(fields: [articleId], references: [id], onDelete: Cascade)
  pageNumber Int
  content    String // markdown transcription from the vision model
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([articleId, pageNumber])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  chats        Chat[]
  researchWorkflows ResearchWorkflow[]
}

// One row per conversation. `messages` stores the full AI SDK v7 UIMessage[]
// array as JSON (jsonb on Postgres) — parts-based, so it naturally preserves
// the exact sequence of reasoning steps, tool calls, and text for a turn,
// not just the final text. That's what lets a page reload replay the same
// "thinking & actions" timeline instead of collapsing it to plain text.
model Chat {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode      String   @default("chat") // "chat" | "chat-assist-ui" — which page/thread UI created this chat, so /recent links back to the right one
  title     String   @default("New chat")
  model     String   @default("gpt-oss")
  thinking  Boolean  @default(false)
  messages  Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt])
}

// --- Research workflows (/workflows) ----------------------------------------
// A long-lived research assignment for an agent. The user shapes `brief`
// by chatting with it (right pane, `chatMessages`), then starts runs: each
// run is one durable Workflow DevKit execution (runId) of a WorkflowAgent
// that searches/reads the library and writes findings. Everything the run
// does is mirrored into ResearchWorkflowEvent so the timeline survives
// restarts and can be read days later. The Workflow DevKit's own state lives
// in the separate "workflow" schema (see .env).
model ResearchWorkflow {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  // What the agent is asked to investigate — its standing instructions.
  brief        String   @default("")
  // AiProviderModel.wireId used for both research runs and the chat pane.
  modelWireId  String?
  // Upper bound on model calls per run (cost/latency control).
  maxSteps     Int      @default(40)
  // "draft" (never run) | "running" | "completed" | "partial" | "failed" | "cancelled" — mirrors the latest run.
  status       String   @default("draft")
  currentRunId String?
  chatMessages Json     @default("[]")
  // Workflow DevKit run id of the chat turn still streaming, if any.
  activeChatRunId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  lastActivityAt DateTime @default(now())

  runs     ResearchRun[]
  events   ResearchWorkflowEvent[]
  findings ResearchFinding[]

  @@index([userId, updatedAt])
}

model ResearchRun {
  id          String           @id @default(cuid())
  workflowId  String
  workflow    ResearchWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  number      Int              // 1-based, per workflow
  // Workflow DevKit run id (wrun_…); null until start() returned.
  wfRunId     String?          @unique
  // "queued" | "running" | "completed" (plan finished) | "partial" (reported, plan steps left open) | "failed" | "cancelled"
  status      String           @default("queued")
  brief       String           // brief as it was when the run started
  modelWireId String?
  modelLabel  String?
  maxSteps    Int
  stepCount   Int              @default(0)
  toolCallCount Int            @default(0)
  // The agent's plan/checklist, as last set by its updatePlan tool: [{ title, status, note? }]
  plan        Json             @default("[]")
  report      String?          // final markdown report
  error       String?
  inputTokens  Int             @default(0)
  outputTokens Int             @default(0)
  startedAt   DateTime?
  endedAt     DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  events   ResearchWorkflowEvent[]
  findings ResearchFinding[]

  @@unique([workflowId, number])
  @@index([workflowId, createdAt])
}

model ResearchWorkflowEvent {
  id         String           @id @default(cuid())
  workflowId String
  workflow   ResearchWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  runId      String?
  run        ResearchRun?     @relation(fields: [runId], references: [id], onDelete: Cascade)
  // "run_started" | "run_completed" | "run_failed" | "run_cancelled" | "thinking" |
  // "tool" | "finding" | "plan" | "note" | "report" | "brief_updated"
  type       String
  title      String
  detail     String?          // markdown body (agent text, error message, …)
  // Tool calls: { tool, input, output, ok, durationMs }; findings: { findingId }; …
  data       Json?
  createdAt  DateTime         @default(now())

  @@index([workflowId, createdAt])
  @@index([runId, createdAt])
}

model ResearchFinding {
  id         String           @id @default(cuid())
  workflowId String
  workflow   ResearchWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  runId      String?
  run        ResearchRun?     @relation(fields: [runId], references: [id], onDelete: SetNull)
  title      String
  content    String           // markdown
  // [{ doi?, url?, title?, page?, quote? }]
  sources    Json             @default("[]")
  confidence String?          // "high" | "medium" | "low"
  tags       String[]         @default([])
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([workflowId, createdAt])
}
