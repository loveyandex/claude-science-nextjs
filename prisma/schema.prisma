generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// One row per indexed PDF from the external article repository.
// `url` is the relative path exactly as returned by ARTICLES_LIST_URL
// (e.g. "libgen.scimag00100000-00100999/10.1002/....pdf") — it's the
// natural unique key since that's also how we re-check "already indexed?"
// on every /make-science and /make-science-gemma4 visit.
model Article {
  id          String   @id @default(cuid())
  url         String   @unique
  pdfUrl      String
  title       String
  abstract    String
  pageCount   Int?
  status      String   @default("indexed") // old (/make-science) pipeline: "indexed" | "failed"
  errorReason String?
  // gemma4 pipeline tracked separately since a url can be indexed by one
  // pipeline and not the other — see make-science-gemma4.
  gemmaStatus String? // null (not run) | "partial" | "indexed" | "failed"
  gemmaError  String?
  // Rolled-up view of this article's per-page embedding state, derived from
  // its ArticlePage rows after every embedding batch. Purely a read
  // optimization for /library and /make-embedding's stat cards — the
  // authoritative, resumable state lives on ArticlePage.
  embeddingStatus String? // null (not run) | "partial" | "embedded" | "failed"
  embeddedAt      DateTime?
  createdAt   DateTime      @default(now())
  pages       ArticlePage[]
}

// One row per PDF page, produced by the make-science-gemma4 pipeline
// (pdf2image render -> Cerebras gemma-4-31b vision call -> markdown).
// Unlike the old pipeline's `firstPage` (removed), every page is stored,
// so chat tools can read a whole article's real content instead of
// re-fetching and re-parsing the PDF live on every call.
model ArticlePage {
  id         String   @id @default(cuid())
  articleId  String
  article    Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  pageNumber Int
  content    String // markdown transcription from Gemma
  createdAt  DateTime @default(now())

  // --- Qdrant embedding state (make-embedding pipeline) -----------------
  // A page is too big to embed as one vector, so it's split into
  // deterministic ~N-token chunks (see backend/app/services/chunking.py).
  // Chunking is a pure function of (content, chunkTokens, chunkOverlap),
  // so chunk *index* is stable across runs — which is what makes
  // "resume this page from chunk 7" correct rather than approximate.
  //
  // embeddingStatus: "pending" (never embedded) | "partial" (some chunks
  // in Qdrant, stopped/failed midway) | "embedded" | "failed".
  embeddingStatus String  @default("pending")
  // Total chunks this page splits into. 0 until the first run computes it.
  chunkCount      Int     @default(0)
  // How many of those chunks are confirmed upserted into Qdrant. The
  // resume cursor: the next run starts this page at chunk #embeddedChunks.
  embeddedChunks  Int     @default(0)
  // sha256 of the content that was chunked, plus the chunk params baked in.
  // If a page is re-transcribed (or the chunk size changes), this stops
  // matching and the page is re-embedded from chunk 0 instead of silently
  // leaving stale vectors behind.
  contentHash     String?
  embeddingModel  String?
  embeddingError  String?
  embeddedAt      DateTime?

  @@unique([articleId, pageNumber])
  @@index([embeddingStatus])
}

// A pool of Cerebras API keys usable by the make-science-gemma4 pipeline —
// managed from /settings, not from backend/.env. If this table is empty
// and CEREBRAS_API_KEY is set in the Next.js app's own .env, it's
// auto-seeded as one entry (source "env") the first time the pool is read.
// The Python backend never stores keys itself: Next.js sends whichever
// key(s) apply to a given /index-article call in the request body.
model CerebrasApiKey {
  id        String   @id @default(cuid())
  label     String?
  key       String
  source    String   @default("manual") // "manual" | "env"
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
}

// Single-row app-wide settings (fixed id "singleton", upserted lazily).
model AppSettings {
  id String @id @default("singleton")
  // "pages_per_pdf" (default): one article at a time, all enabled keys
  // split across that article's pages concurrently.
  // "pdfs_per_key": up to N articles processed concurrently (N = enabled
  // key count), each assigned exactly one key, pages sequential per article.
  gemma4ConcurrencyMode String @default("pages_per_pdf")

  // --- make-embedding (Qdrant) -----------------------------------------
  // Kept here rather than in .env because changing chunk size changes how
  // every page is split, which has to invalidate ArticlePage.contentHash —
  // a database-visible decision, not a deployment detail. The Python
  // service is told these values per request and holds no opinion itself.
  embeddingCollection  String @default("fastembed_articles")
  embeddingModel       String @default("BAAI/bge-small-en")
  embeddingChunkTokens Int    @default(500)
  // Chunks overlap slightly so a sentence split across a boundary is still
  // retrievable from at least one whole-sentence chunk.
  embeddingChunkOverlap Int   @default(60)
  // How many pages are handed to the Python service in one call. Bigger =
  // fewer round trips, but coarser stop granularity.
  embeddingPageBatch    Int   @default(8)
}

// A configured AI provider instance (not a fixed enum) — two rows can both
// be type "openai-compatible" (e.g. a local Ollama box and a remote Groq
// key are unrelated instances of the same wire protocol), so baseUrl/apiKey
// live per-row rather than per-type. Managed from /settings, same
// global/app-wide shape as CerebrasApiKey above (no per-user scoping).
model AiProvider {
  id        String   @id @default(cuid())
  type      String   // "openai-compatible" | "google"
  label     String   // e.g. "Ollama (local)", "Groq"
  baseUrl   String?  // required for "openai-compatible"; unused for "google"
  apiKey    String?  // nullable — many local openai-compatible servers need no key
  enabled   Boolean  @default(true)
  source    String   @default("manual") // "manual" | "env" — same convention as CerebrasApiKey.source
  createdAt DateTime @default(now())
  models    AiProviderModel[]
}

// One selectable chat model under a provider. `wireId` is what the client
// sends as `model` in /api/chat's request body and what's persisted on
// Chat.model — once created it must stay stable, since old Chat rows
// reference it by value indefinitely (see ai-provider.ts's getModel()
// fallback for what happens when a wireId no longer resolves).
model AiProviderModel {
  id         String     @id @default(cuid())
  providerId String
  provider   AiProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  wireId     String     @unique // e.g. "gpt-oss", "gemini-flash-lite", or a cuid for user-added models
  modelName  String     // actual model name sent to the provider API, e.g. "llama3.1:8b"
  label      String?    // optional display override; falls back to modelName
  enabled    Boolean    @default(true)
  createdAt  DateTime   @default(now())

  @@index([providerId])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  chats        Chat[]
}

// One row per conversation. `messages` stores the full AI SDK v7 UIMessage[]
// array as JSON (jsonb on Postgres) — parts-based, so it naturally preserves
// the exact sequence of reasoning steps, tool calls, and text for a turn,
// not just the final text. That's what lets a page reload replay the same
// "thinking & actions" timeline instead of collapsing it to plain text.
model Chat {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode      String   @default("chat") // "chat" | "chat-assist-ui" — which page/thread UI created this chat, so /recent links back to the right one
  title     String   @default("New chat")
  model     String   @default("gpt-oss")
  thinking  Boolean  @default(false)
  messages  Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt])
}
