# --- shared ---------------------------------------------------------------
# Must match the Next.js app's INTERNAL_API_SECRET. Every authenticated
# route here rejects requests until it does.
INTERNAL_API_SECRET=change-me-to-a-random-shared-secret
NEXTJS_BASE_URL=http://localhost:3000

# --- make-science-gemma4 (PDF page -> markdown) ---------------------------
CEREBRAS_API_KEY=csk-...    # optional fallback only — real keys live at /settings (Postgres)
GEMMA_MODEL_NAME=gemma-4-31b
PDF_RENDER_DPI=400
POPPLER_PATH=

# --- make-embedding (markdown -> chunks -> Qdrant) ------------------------
QDRANT_URL=http://localhost:6333
# Only for Qdrant Cloud / a secured instance; leave blank for local Docker.
QDRANT_API_KEY=
QDRANT_TIMEOUT_SECONDS=120
# FastEmbed model, run locally in this process — no API key, no per-token
# cost. Must match whatever the existing collection was built with: changing
# it invalidates every embedded page (they get re-embedded automatically).
EMBEDDING_MODEL_NAME=BAAI/bge-small-en
# Default collection name. The Next.js app normally overrides this per
# request from its own settings (edited on /make-embedding).
QDRANT_COLLECTION=fastembed_articles
# Chunks per upsert call. Smaller = finer-grained progress and less work
# redone when a run is stopped; larger = slightly better encoding throughput.
EMBEDDING_UPSERT_BATCH=32
# FastEmbed's `parallel` setting. Values >1 spawn worker *processes*, which
# doesn't play well with a reloading uvicorn dev server on Windows. Raise it
# for bulk runs on Linux.
EMBEDDING_PARALLEL=1
